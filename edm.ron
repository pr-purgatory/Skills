(rules:[(event:TaskSuccess,skill:"perf-profiler",prompt:"Profile performance of successful task",priority:5),(event:TaskSuccess,skill:"caveman-stats",prompt:"Show session token usage",priority:1),(event:ContextLimitApproaching,skill:"context-janitor",prompt:"Clean up redundant context to save tokens",priority:20),(event:FrontendChange,skill:"visual-audit",prompt:"Audit visual changes against design specs",priority:5),(event:CodeChange,skill:"tdd-enforcer",prompt:"Ensure tests exist for new logic",priority:10),(event:CodeChange,skill:"rust-forge",prompt:"Review and scaffold Rust modules",priority:10),(event:CodeChange,skill:"ui-forge",prompt:"Review and refine UI implementation",priority:10),(event:CodeChange,skill:"lint-hunter",prompt:"Run clippy and fix warnings",priority:5),(event:CodeChange,skill:"vibe-check",prompt:"Verify code matches project style and intent",priority:1),(event:TasksEmpty,skill:"selina",prompt:"Review code for security vulnerabilities",priority:10),(event:TasksEmpty,skill:"doc-sync",prompt:"Sync documentation with current code state",priority:1),(event:SearchQueryLowConfidence,skill:"corrective-rag",prompt:"Verify and expand search results",priority:5),(event:DestructiveCommand,skill:"hitl-checkpoint",prompt:"Request human approval for high-risk action",priority:20),(event:SessionStart,skill:"dependency-sentry",prompt:"Check for security vulnerabilities in dependencies",priority:10),(event:SessionStart,skill:"compress",prompt:"Compress memory files for efficiency",priority:5),(event:SessionStart,skill:"rust-forge",prompt:"Initialize Rust environment and check dependencies",priority:5),(event:SessionStart,skill:"ui-forge",prompt:"Scan project for UI frameworks and initialize smiths",priority:5),(event:ExternalDepAdded,skill:"mcp-scaffold",prompt:"Scaffold MCP server for new dependency",priority:5),(event:TaskFailed,skill:"rust-forge",prompt:"Debug Rust build/test failure",priority:15),(event:TaskFailed,skill:"ui-forge",prompt:"Debug UI-related 